<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VASSA PROPERTIES"
            android:textColor="#38BDF8"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24/7 Real-Time GPS Tracking and Attendance"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 24/7 BACKGROUND TRACKING: ACTIVE"
                android:textColor="#34D399"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmpDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👤 Govind Gore (VP-004) • Director"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvLastSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📡 Pings every 5 mins even when screen is locked"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Quick Action Buttons -->
        <Button
            android:id="@+id/btnCheckIn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="✅ CHECK-IN AND START DUTY"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#10B981"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnToggleTracking"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="▶️ START REAL-TIME TRACKING"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#0284C7"
            android:layout_marginBottom="20dp" />

        <!-- Staff Configuration Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STAFF PROFILE CONFIGURATION"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Employee ID:"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etEmpId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="VP-004"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff Full Name:"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etEmpName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Govind Gore"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Sheets Apps Script Webhook:"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etWebhook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://script.google.com/macros/s/.../exec"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:background="#0F172A"
                android:padding="10dp"
                android:textSize="11sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnSaveConfig"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="💾 SAVE STAFF PROFILE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#334155" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
