<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- 1. Top Brand Card (Matching Web App Brand Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivCompanyLogo"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:maxWidth="210dp"
                android:src="@drawable/vassa_logo_header"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Vassa Properties Logo"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvLiveClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--:--"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvLiveDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#000000"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/tvShiftTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shift: 10:00 AM - 07:00 PM"
                android:textColor="#0369A1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:background="@drawable/bg_pill_shift"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Main Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="10dp">

            <!-- 2. Locked Staff Profile Badge (Anti-Proxy) -->
            <LinearLayout
                android:id="@+id/llProfileBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_profile_locked"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEVICE LOCKED TO STAFF"
                        android:textColor="#059669"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvProfileMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#047857"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnResetAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Reset (Admin)"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_btn_switch"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />
            </LinearLayout>

            <!-- 3. Staff Selection (Shown when device is not locked) -->
            <LinearLayout
                android:id="@+id/llStaffSelectGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. SELECT YOUR NAME (DEVICE WILL LOCK):"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spStaff"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>

            <!-- 4. Live Punch Status Banner -->
            <LinearLayout
                android:id="@+id/llBannerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_radar_inside"
                android:orientation="vertical"
                android:padding="10dp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvBannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check-In Recorded Today!"
                    android:textColor="#047857"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tvBannerTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time: --:-- (Present)"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvBannerWarn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duty is active. Please Check-Out below once your shift ends."
                    android:textColor="#047857"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 5. Site Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. CURRENT DUTY LOCATION / PROJECT SITE:"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spLocation"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>

            <!-- 6. GPS Geofence Radar Card -->
            <LinearLayout
                android:id="@+id/llRadarCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_radar_locating"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvRadarIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRadarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detecting GPS Location..."
                        android:textColor="#0369A1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tvRadarDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking 100m geofence radius (Tap to sync)"
                        android:textColor="#0284C7"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sync"
                    android:textColor="#0369A1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <!-- 7. Dynamic Action Buttons (Red for Check-Out as in Web App) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCheckIn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Check-In Blocked (Select Name)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif"
                android:background="@drawable/bg_btn_disabled"
                app:backgroundTint="@null"
                android:backgroundTint="@null"
                android:enabled="false"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCheckOut"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Punch OUT (End Duty)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif"
                android:background="@drawable/bg_btn_checkout"
                app:backgroundTint="@null"
                android:backgroundTint="@null"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shift: 10:00 AM - 07:00 PM | Auto Checkout: 08:30 PM"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Footer / Settings Link -->
        <TextView
            android:id="@+id/tvAdminSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Google Apps Script Endpoint Settings"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:padding="6dp" />

    </LinearLayout>
</ScrollView>
